{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      // React event handlers and fire-and-forget invalidations read better inline;
      // memoization here is noise for a demo-scale SPA.
      "includes": ["apps/web/src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noVoid": "off"
          },
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/hooks/use-uploads.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/seed.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          },
          "style": {
            "useDestructuring": "off"
          },
          "suspicious": {
            "noLeakedRender": "off"
          }
        }
      }
    },
    {
      "includes": ["**/protected-route.tsx", "**/ProtectedRoute.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          },
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
