{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      // React event handlers and fire-and-forget invalidations read better inline;
      // memoization here is noise for a demo-scale SPA.
      "includes": ["apps/web/src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noVoid": "off"
          },
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/hooks/use-uploads.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/seed.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.integration.test.ts", "**/*.test.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off",
            "useTopLevelRegex": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useConsistentTypeDefinitions": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/src/services/validation.service.ts",
        "apps/api/src/services/ingestion.service.ts",
        "apps/api/src/routes/verified-loans.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          },
          "suspicious": {
            "noConstantBinaryExpressions": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          },
          "style": {
            "useDestructuring": "off"
          },
          "suspicious": {
            "noLeakedRender": "off"
          }
        }
      }
    },
    {
      "includes": ["**/protected-route.tsx", "**/ProtectedRoute.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          },
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/services/ingestion.service.ts"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    },
    {
      "includes": [
        "apps/api/src/lib/ai.ts",
        "apps/api/src/middleware/rate-limit.ts",
        "apps/api/src/services/ai.service.ts",
        "apps/api/src/services/conflict-detection.service.ts",
        "apps/api/src/routes/ai.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          },
          "style": {
            "useDestructuring": "off",
            "useErrorCause": "off"
          },
          "suspicious": {
            "noUnnecessaryConditions": "off"
          }
        }
      }
    }
  ]
}
